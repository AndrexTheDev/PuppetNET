# =============================================================================
#  PuppetNET — environment configuration
# =============================================================================
#  Copy to `.env` for local runs (`cp .env.example .env`) or paste into
#  GitHub → Settings → Secrets and variables → Actions for scheduled runs.
#
#  EVERY value below is optional. The pipeline boots with safe defaults,
#  refuses to write to Neo4j without credentials, and degrades to a
#  no-model lexical parser if spaCy cannot load a model.
#
#  `python ingest.py --doctor` validates this file end to end and
#  `python ingest.py --print-config` echoes it back with secrets redacted.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Neo4j AuraDB (Free tier)  — REQUIRED to persist anything
# ---------------------------------------------------------------------------
# Project → Connect → grab the "neo4j+s://…:7687" URI. AuraDB Free only
# supports the encrypted bolt+s scheme, so keep the `+s`.
NEO4J_URI=neo4j+s://aaaaaaaa.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

NEO4J_MAX_CONNECTION_POOL_SIZE=8
NEO4J_CONNECTION_TIMEOUT_SECONDS=30
NEO4J_TRANSACTION_TIMEOUT_SECONDS=60
NEO4J_BATCH_SIZE=500
NEO4J_MAX_RETRIES=4
# Create constraints/indexes on boot (idempotent DDL, skipped statements are
# logged, never fatal).
NEO4J_ENSURE_SCHEMA=true

# AuraDB Free stops accepting writes at ~200k nodes. Once the :Entity
# population reaches this budget the writer keeps updating existing nodes but
# refuses to create new ones — strongest (most confident, most attested) first —
# and reports how many were refused in the run summary. 0 disables the guard.
AURA_NODE_CAP=200000
# Rows pulled into the cross-run alias index at the start of each run. This is
# also how the node budget knows which nodes already exist, so keep it at or
# above AURA_NODE_CAP.
ENTITY_RESOLVER_LIMIT=200000

# ---------------------------------------------------------------------------
# 2. Cloudflare Worker edge relay (worker.js) — REQUIRED for IP rotation
# ---------------------------------------------------------------------------
# Deploy with `npx wrangler deploy`, then use the printed *.workers.dev URL.
PROXY_WORKER_URL=https://puppetnet-relay.<your-subdomain>.workers.dev
# Shared secret the Worker checks as `Authorization: Bearer <token>`.
# Generate one:  openssl rand -hex 32
PROXY_AUTH_TOKEN=
PROXY_WORKER_ENABLED=true
PROXY_TIMEOUT_SECONDS=30
# On HTTP 429 from the Worker, accept the queued task and poll instead of
# failing the fetch.
PROXY_QUEUE_ON_LIMIT=true
PROXY_TASK_POLL_SECONDS=180
PROXY_TASK_POLL_INTERVAL_SECONDS=3
# Stop routing through the Worker after N consecutive failures, wait, retry.
PROXY_CIRCUIT_BREAKER_THRESHOLD=4
PROXY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Talk to origins directly when the Worker is unavailable. Set false in
# production if you rely on the Worker for rate-limit evasion.
DIRECT_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# 3. Token-bucket delay queue (the Worker-independent fallback)
# ---------------------------------------------------------------------------
# 0.4 req/s ≈ one request every 2.5 s — comfortably under most robots.txt
# Crawl-delay values and News/RSS host limits.
TOKEN_BUCKET_RATE_PER_SEC=0.4
TOKEN_BUCKET_BURST=3
TOKEN_BUCKET_JITTER_SECONDS=0.35
GLOBAL_MIN_INTERVAL_SECONDS=0.75

# ---------------------------------------------------------------------------
# 4. HTTP client
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.2
HTTP_BACKOFF_CAP_SECONDS=45
HTTP_MAX_RESPONSE_BYTES=12582912
# Rotating fingerprints in worker.js supply Accept-Language / Sec-CH-UA. This
# is only used for direct (non-Worker) requests.
HTTP_USER_AGENT=PuppetNET-OSINT/1.5 (+https://github.com/AndrexTheDev/PuppetNET; research bot)
# Extra static headers as JSON, e.g. {"X-Api-Key":"…"}
EXTRA_HEADERS_JSON=

# ---------------------------------------------------------------------------
# 5. NLP (spaCy)
# ---------------------------------------------------------------------------
# Tried in order; the first importable model wins. en_core_web_trf needs
# requirements-nlp-trf.txt (torch). Falls back to a blank pipeline + gazetteer
# if none is present — parsing still works, edges are priced at the
# co-occurrence rate (0.2 penalty).
SPACY_MODELS=en_core_web_trf,en_core_web_lg,en_core_web_md,en_core_web_sm
# Legacy single-model form; if set it is tried before SPACY_MODELS.
SPACY_MODEL=
NLP_ENABLED=true
NLP_LANGUAGE=en
NLP_MAX_CHARS_PER_DOC=400000
NLP_MAX_SENTENCES_PER_DOC=1500
NLP_BATCH_SIZE=16
NLP_MAX_ENTITIES_PER_DOC=400

# Relation extraction
# Drop edges below this confidence before they reach Neo4j.
#   structured source, dependency parse  -> 1.0 × 1.0 × evidence
#   news source, dependency parse        -> 0.4 × 1.0 × evidence
#   news source, co-occurrence fallback  -> 0.4 × 0.8 × evidence
MIN_EDGE_CONFIDENCE=0.05
# Max token distance between two arguments before a triple is discarded.
MAX_ARGUMENT_DISTANCE=24
# Detect CRAFT entities (aircraft registrations, flight numbers, IMO/MMSI,
# vessel prefixes such as MV/SS/R-V).
ENABLE_CRAFT_DETECTION=true
# Sentence-level co-occurrence when dependency parsing yields nothing.
ENABLE_COOCCURRENCE_FALLBACK=true

# ---------------------------------------------------------------------------
# 6. Harvest limits (keep a daily cron inside the 6-hour Actions ceiling)
# ---------------------------------------------------------------------------
MAX_DOCUMENTS_PER_SOURCE=150
MAX_DOCUMENTS_TOTAL=1500
MAX_RUNTIME_SECONDS=2100
CONCURRENCY=4

# ---------------------------------------------------------------------------
# 7. Source selection & state
# ---------------------------------------------------------------------------
SOURCES_FILE=config/sources.yaml
# Comma-separated allowlist (empty = everything enabled in the registry/YAML).
ENABLED_SOURCES=
# Comma-separated denylist.
DISABLED_SOURCES=
# Skip documents whose content hash was seen within DEDUPE_WINDOW_DAYS.
ONLY_NEW_DOCUMENTS=true
DEDUPE_WINDOW_DAYS=30
STATE_DIR=.state
REPORT_DIR=reports

# ---------------------------------------------------------------------------
# 8. Per-source credentials & queries
# ---------------------------------------------------------------------------
# ICIJ Offshore Leaks (no key required, be polite)
ICIJ_DATASET_URLS=
ICIJ_QUERY_TERMS=

# NOTE ON SECRETS: every credential below can *instead* live on the Worker
# (`wrangler secret put OPENCORPORATES_API_TOKEN`, see wrangler.toml). Its host
# profiles inject the token on the outgoing request and strip it from every URL
# they report or cache, so a runner-side value is only needed for direct
# (non-relayed) fetches. Keeping them Worker-side also keeps them out of the
# GitHub Actions log.

# OpenCorporates — free tier: 50 calls/day without a token, far more with one.
OPENCORPORATES_API_TOKEN=
OPENCORPORATES_ENDPOINT=https://api.opencorporates.com/v0.4

# UK Companies House — free key, 600 calls per 5 minutes.
COMPANIES_HOUSE_API_KEY=

# Wikidata requires a descriptive UA with contact details (their ToS), and the
# relay sends SPARQL as a form POST capped at 0.25 req/s with maxlag=5.
WIKIDATA_USER_AGENT=PuppetNET-OSINT/1.5 (https://github.com/AndrexTheDev/PuppetNET; contact: you@example.org)
WIKIDATA_ENDPOINT=https://query.wikidata.org/sparql
# Named queries implemented in puppetnet/sources/wikidata.py:
#   ownership, subsidiaries, board_members, foundation_trustees,
#   aircraft_operators, vessel_operators, political_positions,
#   employer, sanctioned_entities, state_owned, custom
WIKIDATA_QUERIES=

# Aviation — tail numbers are what turn these sources on.
#   faa_registry   streams the monthly Releasable Aircraft ZIP directly (it is
#                  too large to buffer through the relay) and derives
#                  :SHARES_ADDRESS edges between co-located registrants.
#   adsb_exchange  adsbdb.com (free, no key) or ADS-B Exchange v2 on RapidAPI.
#   flight_logs    CSV/TSV/JSON manifests → :PASSENGER_ON + :TRAVELED_WITH.
FAA_REGISTRY_URL=
AIRCRAFT_TAIL_NUMBERS=
FLIGHT_LOG_URLS=
ADSDBD_ENDPOINT=https://www.adsbdb.com/api/v1
ADSBEXCHANGE_ENDPOINT=https://adsbexchange-com1.p.rapidapi.com
ADSBEXCHANGE_API_KEY=
RAPIDAPI_HOST=adsbexchange-com1.p.rapidapi.com

# Local sanctions/registry dumps (CSV/JSON) for the register_files adapter.
REGISTER_FILES=

# Extra RSS/Atom feeds appended to the news sources.
RSS_FEEDS=

# ---------------------------------------------------------------------------
# 9. Calculated layer (analytics) — runs after the graph is written
# ---------------------------------------------------------------------------
# Walks each person's neighbourhood and writes
#   (:Person)-[:PUPPET_MASTER_OF {score}]->(:Entity)
# plus Person.risk_score. Components: control_breadth 0.30, opacity 0.25,
# layering 0.20, convergence 0.10, adversarial 0.10, movement 0.05; chain decay
# 0.7 per hop, max 4 hops. A failure here never fails the run.
ANALYTICS_ENABLED=true
ANALYTICS_MAX_PERSONS=5000
ANALYTICS_GRAPH_EDGE_LIMIT=50000
# Calculated edges go stale: drop any not refreshed by a run within this window.
ANALYTICS_PRUNE_DAYS=14
PUPPET_MASTER_MIN_SCORE=0.40
PUPPET_MASTER_TOP_N=8
PUPPET_MASTER_MAX_EDGES=2000

# ---------------------------------------------------------------------------
# 10. Graph maintenance (graph_analytics.py) — dedupe, prune, centrality
# ---------------------------------------------------------------------------
# AuraDB Free stops at 200k nodes / 400k relationships. This pass keeps the
# database inside that budget and scores what is left. It runs *after* the
# ingest (see .github/workflows/graph_maintenance.yml), never during it.
#
# Entity resolution. Two paths:
#   strict — an exact match on a globally unique identifier (registration
#            number, LEI, IMO, MMSI, transponder, ICAO24, tail number,
#            Wikidata/Wikipedia id). No further evidence required.
#   fuzzy  — Jaro-Winkler / Levenshtein above DEDUPE_FUZZY_THRESHOLD.
# Homonym guard: a fuzzy pair only merges when at least one contextual
# attribute is shared — the same normalised address, a shared strict
# identifier, or both names within DEDUPE_COOCCURRENCE_WINDOW_WORDS words of
# the same document. Generic names ("Global Holdings Ltd"), names held by more
# than six nodes, and token-only matches ("Ivan Petrov" / "Petrov Ivan") always
# require that corroboration; they are reported as `homonyms_protected`.
DEDUPE_ENABLED=true
DEDUPE_FUZZY_THRESHOLD=0.88
# Hard ceiling per run: merges are auditable but not free, and one wrong
# threshold must not be able to rewrite the graph in a single pass.
DEDUPE_MAX_MERGES=500
DEDUPE_ENTITY_LIMIT=60000
DEDUPE_COOCCURRENCE_WINDOW_WORDS=50
DEDUPE_COOCCURRENCE_DAYS=90

# Capacity pruning. An orphan is a node with at most PRUNE_ORPHAN_MAX_DEGREE
# semantic ties whose weakest tie scores below PRUNE_ORPHAN_MAX_WEIGHT and which
# has not been touched for PRUNE_ORPHAN_MIN_AGE_DAYS days. Nodes with a
# risk_score >= PUPPET_MASTER_MIN_SCORE, and offshore/shell-labelled nodes with
# at least one tie, are never purged — they are the findings, not the litter.
# Once utilisation passes PRUNE_CAPACITY_TARGET the rule escalates automatically
# (degree <= 2, weight < 0.4, age > 90 days).
PRUNE_ENABLED=true
PRUNE_ORPHAN_MAX_DEGREE=1
PRUNE_ORPHAN_MAX_WEIGHT=0.3
PRUNE_ORPHAN_MIN_AGE_DAYS=180
PRUNE_MAX_DELETIONS=20000
PRUNE_CAPACITY_TARGET=0.85

# Centrality + anomaly scoring. AuraDB Free has no GDS, so CENTRALITY_ENGINE
# "auto" probes for it and otherwise uses the bundled pure-Python Brandes
# implementation (no extra dependency). The score is
#   w1·betweenness + w2·24h_degree_spike + w3·offshore_cluster_ratio
# with the weights below; they must sum to 1.0.
CENTRALITY_ENABLED=true
CENTRALITY_MAX_NODES=4000
CENTRALITY_ENGINE=auto
CENTRALITY_MAX_SECONDS=240
ANOMALY_WEIGHTS=0.40,0.35,0.25
ANOMALY_TOP_N=5
ANOMALY_DEGREE_SPIKE_WINDOW_HOURS=30
TELEGRAM_BRIDGE_ALERT_LIMIT=10
# AuraDB Free ceilings. The maintenance pass reports utilisation against these
# and escalates pruning when either one is passed.
AURA_NODE_CAP=200000
AURA_EDGE_CAP=400000

# ---------------------------------------------------------------------------
# 11. Telegram alerts (telegram_bot.py) — bridges + daily digest
# ---------------------------------------------------------------------------
# Create the bot with @BotFather, add it to the channel, then put the token in
# the repository secrets (TELEGRAM_BOT_TOKEN). The token is a credential: it is
# never logged (a logging filter scrubs it), never written to a report, never
# sent through the edge relay, and redacted in every run summary.
#
# Two message classes:
#   bridge alert — a node first seen inside ANOMALY_DEGREE_SPIKE_WINDOW_HOURS
#                  that is an articulation point joining two clusters which had
#                  no path between them before. Suppressed for
#                  TELEGRAM_SUPPRESSION_HOURS per (node, cluster pair).
#   daily digest — the ANOMALY_TOP_N / TELEGRAM_DIGEST_TOP_N highest-scoring
#                  nodes, at most once per chat per UTC day.
# State lives in .state/telegram_alerts.json; delete it to re-send everything.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Numeric ids (-1001234567890) or @channelname, comma separated.
TELEGRAM_CHAT_IDS=
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_PARSE_MODE=HTML
# ~1 msg/s with a small burst: far inside Telegram's 30/s global and
# 20/min-per-group limits, and it keeps a channel readable.
TELEGRAM_RATE_PER_SEC=1.0
TELEGRAM_BURST=5.0
TELEGRAM_SEND_RETRIES=3
TELEGRAM_SUPPRESSION_HOURS=24
TELEGRAM_DIGEST_TOP_N=5
TELEGRAM_DISABLE_LINK_PREVIEW=true

# ---------------------------------------------------------------------------
# 12. Run behaviour
# ---------------------------------------------------------------------------
# true = harvest and parse but write nothing to Neo4j (safe smoke test).
DRY_RUN=false
LOG_LEVEL=INFO
LOG_JSON=false
# Exit non-zero if any source recorded an error (fails the GitHub Action).
FAIL_ON_ERROR=false
RUN_ID=
RANDOM_SEED=1337

# ---------------------------------------------------------------------------
# 14. Web console (web/) and its graph read API
# ---------------------------------------------------------------------------
# The SPA in web/ is static and ships no credentials: it calls the Worker's
# /graph/* endpoints, which reuse the NEO4J_* values from section 1 above. Those
# are set as Worker secrets (`wrangler secret put NEO4J_URI`), never as vars.
#
# Bearer token the console presents. Keep it separate from PROXY_AUTH_TOKEN so a
# leaked dashboard token can be rotated without touching the ingest pipeline; if
# it is unset the graph API accepts PROXY_AUTH_TOKEN instead.
GRAPH_API_TOKEN=
# Where the console is deployed (Cloudflare Pages). Used for the ALLOWED_ORIGINS
# CORS value on the Worker and for the deep links in docs/web-console.md.
WEB_CONSOLE_URL=https://puppetnet.pages.dev
# Public read-only console (no token). Leave false unless the graph holds
# nothing you would mind a stranger paging through — it is still rate-limited.
GRAPH_PUBLIC_READ=false
# Everything else (rate limits, ceilings, cache TTL) lives in wrangler.toml under
# "Graph read API"; see docs/web-console.md.

# ---------------------------------------------------------------------------
# 13. Injected by GitHub Actions (do not set locally)
# ---------------------------------------------------------------------------
# The run report embeds these so every edge can be traced back to the workflow
# run that produced it.
#GITHUB_RUN_ID=
#GITHUB_SHA=
#GITHUB_WORKFLOW=
