# PuppetNET 2.0 — only free/local services. This file is documentation, not
# automatically loaded: export values for Python; use Wrangler secrets for Worker.
# Never put database credentials or API tokens into NEXT_PUBLIC_* variables.
DRY_RUN=true
NEO4J_URI=neo4j+s://YOUR-FREE-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_NODE_CAP=200000
AURA_EDGE_CAP=400000
PROXY_WORKER_URL=
PROXY_AUTH_TOKEN=
GRAPH_API_TOKEN=
GRAPH_PUBLIC_READ=false
# Optional Workers KV FREE namespace ID, mapped to RATE_LIMIT_KV in wrangler.toml.
# CF_KV_NAMESPACE alone does not create/bind a namespace.
CF_KV_NAMESPACE=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
ENABLED_SOURCES=wikidata,news_world
MAX_DOCUMENTS_TOTAL=100
MAX_DOCUMENTS_PER_SOURCE=25
MAX_RUNTIME_SECONDS=300
SPACY_MODELS=en_core_web_sm
ANALYTICS_ENABLED=false
DIRECT_FALLBACK_ENABLED=true

# Optional local CPU GLiNER (install packages/pipeline[gliner]); used by Actions ingestion.
NLP_BACKEND=gliner
GLINER_MODEL=urchade/gliner_small-v2.1
GLINER_THRESHOLD=0.5
