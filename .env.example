# =============================================================================
#  PuppetNET — environment configuration
# =============================================================================
#  Copy to `.env` for local runs (`cp .env.example .env`) or paste into
#  GitHub → Settings → Secrets and variables → Actions for scheduled runs.
#
#  EVERY value below is optional. The pipeline boots with safe defaults,
#  refuses to write to Neo4j without credentials, and degrades to a
#  no-model lexical parser if spaCy cannot load a model.
#
#  `python ingest.py --doctor` validates this file end to end and
#  `python ingest.py --print-config` echoes it back with secrets redacted.
# =============================================================================

# ---------------------------------------------------------------------------
# 1. Neo4j AuraDB (Free tier)  — REQUIRED to persist anything
# ---------------------------------------------------------------------------
# Project → Connect → grab the "neo4j+s://…:7687" URI. AuraDB Free only
# supports the encrypted bolt+s scheme, so keep the `+s`.
NEO4J_URI=neo4j+s://aaaaaaaa.databases.neo4j.io:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

NEO4J_MAX_CONNECTION_POOL_SIZE=8
NEO4J_CONNECTION_TIMEOUT_SECONDS=30
NEO4J_TRANSACTION_TIMEOUT_SECONDS=60
NEO4J_BATCH_SIZE=500
NEO4J_MAX_RETRIES=4
# Create constraints/indexes on boot (idempotent DDL, skipped statements are
# logged, never fatal).
NEO4J_ENSURE_SCHEMA=true

# AuraDB Free stops accepting writes at ~200k nodes. Once the :Entity
# population reaches this budget the writer keeps updating existing nodes but
# refuses to create new ones — strongest (most confident, most attested) first —
# and reports how many were refused in the run summary. 0 disables the guard.
AURA_NODE_CAP=200000
# Rows pulled into the cross-run alias index at the start of each run. This is
# also how the node budget knows which nodes already exist, so keep it at or
# above AURA_NODE_CAP.
ENTITY_RESOLVER_LIMIT=200000

# ---------------------------------------------------------------------------
# 2. Cloudflare Worker edge relay (worker.js) — REQUIRED for IP rotation
# ---------------------------------------------------------------------------
# Deploy with `npx wrangler deploy`, then use the printed *.workers.dev URL.
PROXY_WORKER_URL=https://puppetnet-relay.<your-subdomain>.workers.dev
# Shared secret the Worker checks as `Authorization: Bearer <token>`.
# Generate one:  openssl rand -hex 32
PROXY_AUTH_TOKEN=
PROXY_WORKER_ENABLED=true
PROXY_TIMEOUT_SECONDS=30
# On HTTP 429 from the Worker, accept the queued task and poll instead of
# failing the fetch.
PROXY_QUEUE_ON_LIMIT=true
PROXY_TASK_POLL_SECONDS=180
PROXY_TASK_POLL_INTERVAL_SECONDS=3
# Stop routing through the Worker after N consecutive failures, wait, retry.
PROXY_CIRCUIT_BREAKER_THRESHOLD=4
PROXY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# Talk to origins directly when the Worker is unavailable. Set false in
# production if you rely on the Worker for rate-limit evasion.
DIRECT_FALLBACK_ENABLED=true

# ---------------------------------------------------------------------------
# 3. Token-bucket delay queue (the Worker-independent fallback)
# ---------------------------------------------------------------------------
# 0.4 req/s ≈ one request every 2.5 s — comfortably under most robots.txt
# Crawl-delay values and News/RSS host limits.
TOKEN_BUCKET_RATE_PER_SEC=0.4
TOKEN_BUCKET_BURST=3
TOKEN_BUCKET_JITTER_SECONDS=0.35
GLOBAL_MIN_INTERVAL_SECONDS=0.75

# ---------------------------------------------------------------------------
# 4. HTTP client
# ---------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=25
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_SECONDS=1.2
HTTP_BACKOFF_CAP_SECONDS=45
HTTP_MAX_RESPONSE_BYTES=12582912
# Rotating fingerprints in worker.js supply Accept-Language / Sec-CH-UA. This
# is only used for direct (non-Worker) requests.
HTTP_USER_AGENT=PuppetNET-OSINT/1.4 (+https://github.com/AndrexTheDev/PuppetNET; research bot)
# Extra static headers as JSON, e.g. {"X-Api-Key":"…"}
EXTRA_HEADERS_JSON=

# ---------------------------------------------------------------------------
# 5. NLP (spaCy)
# ---------------------------------------------------------------------------
# Tried in order; the first importable model wins. en_core_web_trf needs
# requirements-nlp-trf.txt (torch). Falls back to a blank pipeline + gazetteer
# if none is present — parsing still works, edges are priced at the
# co-occurrence rate (0.2 penalty).
SPACY_MODELS=en_core_web_trf,en_core_web_lg,en_core_web_md,en_core_web_sm
# Legacy single-model form; if set it is tried before SPACY_MODELS.
SPACY_MODEL=
NLP_ENABLED=true
NLP_LANGUAGE=en
NLP_MAX_CHARS_PER_DOC=400000
NLP_MAX_SENTENCES_PER_DOC=1500
NLP_BATCH_SIZE=16
NLP_MAX_ENTITIES_PER_DOC=400

# Relation extraction
# Drop edges below this confidence before they reach Neo4j.
#   structured source, dependency parse  -> 1.0 × 1.0 × evidence
#   news source, dependency parse        -> 0.4 × 1.0 × evidence
#   news source, co-occurrence fallback  -> 0.4 × 0.8 × evidence
MIN_EDGE_CONFIDENCE=0.05
# Max token distance between two arguments before a triple is discarded.
MAX_ARGUMENT_DISTANCE=24
# Detect CRAFT entities (aircraft registrations, flight numbers, IMO/MMSI,
# vessel prefixes such as MV/SS/R-V).
ENABLE_CRAFT_DETECTION=true
# Sentence-level co-occurrence when dependency parsing yields nothing.
ENABLE_COOCCURRENCE_FALLBACK=true

# ---------------------------------------------------------------------------
# 6. Harvest limits (keep a daily cron inside the 6-hour Actions ceiling)
# ---------------------------------------------------------------------------
MAX_DOCUMENTS_PER_SOURCE=150
MAX_DOCUMENTS_TOTAL=1500
MAX_RUNTIME_SECONDS=2100
CONCURRENCY=4

# ---------------------------------------------------------------------------
# 7. Source selection & state
# ---------------------------------------------------------------------------
SOURCES_FILE=config/sources.yaml
# Comma-separated allowlist (empty = everything enabled in the registry/YAML).
ENABLED_SOURCES=
# Comma-separated denylist.
DISABLED_SOURCES=
# Skip documents whose content hash was seen within DEDUPE_WINDOW_DAYS.
ONLY_NEW_DOCUMENTS=true
DEDUPE_WINDOW_DAYS=30
STATE_DIR=.state
REPORT_DIR=reports

# ---------------------------------------------------------------------------
# 8. Per-source credentials & queries
# ---------------------------------------------------------------------------
# ICIJ Offshore Leaks (no key required, be polite)
ICIJ_DATASET_URLS=
ICIJ_QUERY_TERMS=

# OpenCorporates — free tier: 50 calls/day without a token
OPENCORPORATES_API_TOKEN=

# UK Companies House — free key, 600 calls per 5 minutes
COMPANIES_HOUSE_API_KEY=

# Wikidata requires a descriptive UA with contact details (their ToS).
WIKIDATA_USER_AGENT=PuppetNET-OSINT/1.4 (https://github.com/AndrexTheDev/PuppetNET; contact: you@example.org)
# Named queries implemented in puppetnet/sources/wikidata.py:
#   ownership, subsidiaries, board_members,
#   aircraft_operators, vessel_operators, political_positions
WIKIDATA_QUERIES=

# Local sanctions/registry dumps (CSV/JSON) for the register_files adapter.
REGISTER_FILES=

# Extra RSS/Atom feeds appended to the news sources.
RSS_FEEDS=

# ---------------------------------------------------------------------------
# 9. Run behaviour
# ---------------------------------------------------------------------------
# true = harvest and parse but write nothing to Neo4j (safe smoke test).
DRY_RUN=false
LOG_LEVEL=INFO
LOG_JSON=false
# Exit non-zero if any source recorded an error (fails the GitHub Action).
FAIL_ON_ERROR=false
RUN_ID=
RANDOM_SEED=1337

# ---------------------------------------------------------------------------
# 10. Injected by GitHub Actions (do not set locally)
# ---------------------------------------------------------------------------
# The run report embeds these so every edge can be traced back to the workflow
# run that produced it.
#GITHUB_RUN_ID=
#GITHUB_SHA=
#GITHUB_WORKFLOW=
