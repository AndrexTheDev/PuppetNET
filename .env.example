# PuppetNET 2.0 — only free/local services. This file is documentation, not
# automatically loaded: export values for Python; use Wrangler secrets for Worker.
# Never put database credentials or API tokens into NEXT_PUBLIC_* variables.
DRY_RUN=true
NEO4J_URI=neo4j+s://YOUR-FREE-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
AURA_NODE_CAP=200000
# New entity nodes stop at 90 % of the ceiling; the reserve is for merges and
# repairs. Set to 0 to fill up to AURA_NODE_CAP instead.
AURA_NODE_STOP=180000
AURA_EDGE_CAP=400000
PROXY_WORKER_URL=
PROXY_AUTH_TOKEN=
GRAPH_API_TOKEN=
GRAPH_PUBLIC_READ=false
# Workers KV (Free tier): two namespaces are bound in apps/worker/wrangler.toml —
# RATE_LIMIT_KV (distributed locks, rate buckets, robots cache) and RESULT_KV
# (response cache, deferred tasks). Create them with
#   npx wrangler kv namespace create PUPPETNET_RATE_LIMIT
#   npx wrangler kv namespace create PUPPETNET_RESULTS
# and paste the ids into the file; this variable is only a place to record one.
CF_KV_NAMESPACE=
# /status dashboard (Worker-side, listed for discovery). Without STATUS_TOKEN the
# page accepts GRAPH_API_TOKEN/PROXY_AUTH_TOKEN; STATUS_PUBLIC=true opens the
# read-only view but never a live probe.
STATUS_TOKEN=
STATUS_PUBLIC=false
# Cloudflare Analytics for the Workers-requests card on /status. The Worker reads
# these under the names CF_ACCOUNT_ID / CF_API_TOKEN (Account Analytics: Read);
# they can hold the same values as the Workers AI pair below.
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Shared with Workers AI below. The ingest job reads them only when
# TRIPLET_BACKEND=cloudflare; they are never exposed to the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
ENABLED_SOURCES=wikidata,news_world
MAX_DOCUMENTS_TOTAL=100
MAX_DOCUMENTS_PER_SOURCE=25
MAX_RUNTIME_SECONDS=300
SPACY_MODELS=en_core_web_sm
ANALYTICS_ENABLED=false
DIRECT_FALLBACK_ENABLED=true

# Optional local CPU GLiNER (install packages/pipeline[gliner]); used by Actions ingestion.
NLP_BACKEND=gliner
# urchade/gliner_multi-v2.1 is Apache-2.0, 209M params, multilingual (de/ru/ar/fr/es/...).
# gliner_small-v2.1 is the faster English-only fallback.
GLINER_MODEL=urchade/gliner_multi-v2.1
GLINER_THRESHOLD=0.5
# torch (default) or onnx. ONNX needs a checkpoint that ships model.onnx.
GLINER_RUNTIME=torch
GLINER_CONTEXT_TOKENS=384
GLINER_OVERLAP_TOKENS=64

# Workers AI (Cloudflare free tier: 10,000 neurons/day, hard stop after that).
# off = no relation extraction. cloudflare = subject-predicate-object extraction.
TRIPLET_BACKEND=off
CF_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CF_AI_DAILY_NEURONS=10000
# Defaults to $STATE_DIR/cloudflare_ai_budget.json.
CF_AI_BUDGET_FILE=
CF_AI_MAX_OUTPUT_TOKENS=700
CF_AI_MAX_CHUNKS=32
# Per-run document cap; 0 disables the LLM stage without changing credentials.
CF_AI_MAX_DOCUMENTS=10
CF_AI_MAX_TRIPLETS_PER_CHUNK=20
CF_AI_TIMEOUT_SECONDS=45
# Leave empty to use the published neuron rates for CF_AI_MODEL.
CF_AI_INPUT_NEURONS_PER_MILLION=
CF_AI_OUTPUT_NEURONS_PER_MILLION=

# APOC entity resolution (entity_resolution.py) — free APOC Core on Aura.
RESOLUTION_ENABLED=true
RESOLUTION_THRESHOLD=0.90
RESOLUTION_MAX_MERGES=250
RESOLUTION_ENTITY_LIMIT=20000
RESOLUTION_BLOCK_PREFIX=4
RESOLUTION_COOCCURRENCE_DAYS=365

# Circular ownership detection.
CYCLE_DETECTION_ENABLED=true
CYCLE_EDGE_LIMIT=50000
CYCLE_MAX_STARTS=2000
CYCLE_MAX_LENGTH=12

# Cypher PUPPET_MASTER_OF (PageRank + betweenness + in-degree; Aura Free has no GDS).
PUPPET_MASTER_CYPHER_ENABLED=true
PUPPET_MASTER_MAX_NODES=5000
PUPPET_MASTER_PAGERANK_ITERATIONS=12
PUPPET_MASTER_DAMPING=0.85
PUPPET_MASTER_PAGERANK_WEIGHT=0.50
PUPPET_MASTER_BETWEENNESS_WEIGHT=0.30
PUPPET_MASTER_IN_DEGREE_WEIGHT=0.20

# AuraDB Free pauses after 72 h without a connection; the scheduled job pings daily.
KEEP_ALIVE_TIMEOUT_SECONDS=30
KEEP_ALIVE_RETRIES=2
