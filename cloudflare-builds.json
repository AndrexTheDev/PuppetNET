{
  "_note": "Documented dashboard settings; NOT an auto-consumed Cloudflare config file. Paths are relative to repository root, with no leading slash. Root lockfile and test dependencies are intentionally included. The build command may be entered either as the full root form or, with rootDirectory apps/web, as 'npm run ci:pages' \u2014 both workspaces delegate to the root gate and the gate anchors itself to the repository.",
  "pages": {
    "rootDirectory": "apps/web",
    "productionBranch": "main",
    "buildCommand": "npm run ci:pages",
    "outputDirectory": "out",
    "deployCommand": null,
    "manualDeployCommand": "cd ../.. && npm run deploy:pages",
    "environment": {
      "NODE_VERSION": "22",
      "NEXT_TELEMETRY_DISABLED": "1"
    },
    "productionEnvironment": {
      "SITE_ORIGIN": "https://puppetnet-web.pages.dev"
    },
    "watchPaths": [
      "apps/web/*",
      "package.json",
      "package-lock.json",
      "scripts/pages-build.mjs",
      "tests/web_smoke.mjs",
      "tests/helpers/*",
      "apps/worker/worker.js",
      "tests/dashboard.test.ts",
      "tests/data_fetcher.test.ts",
      "scripts/generate-seo.js",
      "scripts/generate-seo-data.ts",
      "scripts/generate-sitemap.mjs",
      "scripts/emit-og-images.mjs",
      "tests/release.test.mjs",
      "scripts/finalize-static-export.mjs"
    ],
    "buildCommandFromRepoRoot": "cd apps/web && npm run ci:pages"
  },
  "worker": {
    "rootDirectory": "apps/worker",
    "productionBranch": "main",
    "buildCommand": "npm run ci:worker",
    "deployCommand": "npm run deploy",
    "previewCommand": "npm exec -- wrangler versions upload",
    "environment": {
      "NODE_VERSION": "22"
    },
    "watchPaths": [
      "apps/worker/*",
      "package.json",
      "package-lock.json",
      "scripts/worker-build.mjs",
      "tests/worker_smoke.mjs",
      "tests/helpers/*",
      "tests/test_robots.py",
      "tests/search_worker.test.ts",
      "scripts/provision-search-worker.mjs"
    ]
  }
}
