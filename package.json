{
  "name": "puppetnet",
  "version": "2.0.0",
  "private": true,
  "description": "PuppetNET 2.0 zero-cost monorepo: static Next.js frontend, Cloudflare Worker relay and Python NLP pipeline.",
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit.mjs",
    "emit:seo": "node scripts/generate-seo.js",
    "check": "npm run check -w @puppetnet/worker",
    "test:worker": "node --import tsx --test tests/search_worker.test.ts",
    "test:provision": "node --test tests/provision.test.mjs tests/provision_e2e.test.mjs",
    "test:web": "node tests/web_smoke.mjs",
    "test": "npm run check && npm run test:worker && npm run test:web",
    "dev": "npm run dev -w @puppetnet/web",
    "build": "npm run build -w @puppetnet/web",
    "preview": "python3 -m http.server 8080 --directory apps/web/out --bind 0.0.0.0",
    "test:scaffold": "node --test tests/scaffold.test.mjs",
    "ci:pages": "node scripts/pages-build.mjs",
    "ci:worker": "node scripts/worker-build.mjs",
    "provision:worker": "node scripts/provision-search-worker.mjs",
    "test:dashboard": "node --import tsx --test tests/dashboard.test.ts",
    "test:export": "node tests/export_smoke.mjs",
    "emit:og": "node scripts/emit-og-images.mjs",
    "emit:entities": "node --import tsx scripts/emit-entity-data.ts",
    "emit:sitemap": "node scripts/generate-sitemap.mjs",
    "test:seo": "node --import tsx --test tests/seo.test.ts",
    "test:a11y": "node --import tsx --test tests/a11y.test.tsx",
    "test:i18n": "node --import tsx --test tests/i18n.test.tsx",
    "deploy:pages": "npm exec --workspace=@puppetnet/worker -- wrangler pages deploy --cwd ../web",
    "test:worker:legacy": "node tests/worker_smoke.mjs && node tests/worker_hardening.mjs",
    "test:data-fetcher": "node --import tsx --test tests/data_fetcher.test.ts"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/web",
    "apps/worker"
  ],
  "overrides": {
    "postcss": "8.5.31",
    "source-map-js": "1.2.2"
  }
}
