# Editors / OS
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Generated by `npm run audit` — a snapshot of one run, not a source file.
docs/audit/

# Written at deploy time from the deployment origin (npm run emit:seo). A
# committed sitemap would have to guess a hostname; see docs/web-console.md.
web/sitemap.xml
apps/web/public/sitemap.xml
apps/web/public/sitemap-*.xml
apps/web/public/legacy/sitemap.xml

# Pipeline publication of public entity profiles (generated; the committed
# demo dataset lives beside it as entities.sample.json).
apps/web/public/data/entities.json

# Rendered by `npm run screenshots`; CI uploads them as a build artefact.
.screenshots/

# Next static scaffold
.next/
apps/web/out/
.vercel/

# TypeScript incremental compiler cache
*.tsbuildinfo

# Build-only SEO manifest and shared token mirror for the legacy static app.
apps/web/public/data/seo-metadata.json
apps/web/public/styles/globals.css
