/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: frame-ancestors 'self'

# -----------------------------------------------------------------------------
#  Next.js static export (v2)
# -----------------------------------------------------------------------------
#  Every filename below /_next/static/ contains a content hash, so it can be
#  cached for a year without a revalidation request. The exported HTML itself
#  must always be revalidated: a stale shell that points at deleted chunks is
#  the one failure mode a static deployment cannot recover from on its own.
#
#  The archived v1 console no longer ships: `/legacy` is a permanent redirect
#  (see public/_redirects and app/legacy/page.tsx), so it only ever answers
#  with a tiny redirect document that must not be cached long.
# -----------------------------------------------------------------------------

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/dashboard
  Cache-Control: no-cache

/dashboard/*
  Cache-Control: no-cache

/entity
  Cache-Control: no-cache

/entity/*
  Cache-Control: no-cache

/legacy
  Cache-Control: no-cache

/legacy/*
  Cache-Control: no-cache

# Static social cards (1200x630 PNG). They only change with a release.
/og/*
  Cache-Control: public, max-age=604800, must-revalidate

/media/*
  Cache-Control: public, max-age=86400, must-revalidate

/data/*
  Cache-Control: public, max-age=60, s-maxage=60, must-revalidate

# -----------------------------------------------------------------------------
#  Wave 6 (PWA + English landing)
# -----------------------------------------------------------------------------
#  The service worker itself must never be cached: a stale worker would pin an
#  old publication. The manifest may revalidate briefly. /en/ follows the same
#  HTML-shell rule as every other document (no-cache, cheap revalidation).

/sw.js
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/en
  Cache-Control: no-cache

/en/*
  Cache-Control: no-cache
